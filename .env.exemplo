# Copie este arquivo para ".env" e cole sua chave. O arquivo .env nao vai para o GitHub.
GEMINI_API_KEY=cole_sua_chave_aqui
# Modelo usado na extracao. Se der erro de modelo inexistente, troque aqui.
GEMINI_MODEL=gemini-3.8-flash
# Pausa entre chamadas, em segundos, para respeitar a cota gratuita.
PAUSA_SEGUNDOS=20
# Quantas vezes cada processo e extraido, para medir consistencia.
RODADAS=3
